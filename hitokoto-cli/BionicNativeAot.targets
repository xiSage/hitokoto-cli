<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    NativeAOT toolchain configuration for Android (bionic libc) targets.

    Only active when publishing for a linux-bionic-* RID; no-op for every other build.
    Requires the ANDROID_NDK_ROOT environment variable to point at an extracted NDK
    (r26b or newer). Tested with the standalone-executable output type; for JNI .so
    libraries additional -z noexecstack / naming tweaks would be needed.

    Background: .NET 9+ can produce NativeAOT binaries for linux-bionic RIDs, but the
    runtime flags the target as "unsupported", so builds must pass
    -p:DisableUnsupportedError=true (and -p:PublishAotUsingRuntimePack=true to link
    against the prebuilt runtime pack instead of compiling CoreCLR from source).
    The NDK clang/llvm-objcopy and sysroot must be wired up explicitly.
  -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux-bionic'))">
    <NdkHost Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux-x86_64</NdkHost>
    <NdkHost Condition="$([MSBuild]::IsOSPlatform('OSX'))">darwin-x86_64</NdkHost>
    <NdkHost Condition="$([MSBuild]::IsOSPlatform('Windows'))">windows-x86_64</NdkHost>

    <NdkToolchain>$(ANDROID_NDK_ROOT)/toolchains/llvm/prebuilt/$(NdkHost)</NdkToolchain>
    <SysRoot>$(NdkToolchain)/sysroot</SysRoot>

    <!-- Linux/macOS can invoke the NDK executables directly. Windows needs .cmd wrappers
         (generated by the PrepareNdkBatches target below) because MSBuild can't call
         the bare NDK executables on Windows. -->
    <CppCompilerAndLinker Condition="'$(OS)' != 'Windows_NT'">$(NdkToolchain)/bin/clang</CppCompilerAndLinker>
    <ObjCopyName Condition="'$(OS)' != 'Windows_NT'">$(NdkToolchain)/bin/llvm-objcopy</ObjCopyName>
    <CppCompilerAndLinker Condition="'$(OS)' == 'Windows_NT'">android-clang.cmd</CppCompilerAndLinker>
    <ObjCopyName Condition="'$(OS)' == 'Windows_NT'">android-llvm-objcopy.cmd</ObjCopyName>
  </PropertyGroup>

  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux-bionic'))">
    <!-- The NDK clang is a multi-target wrapper; tell it which Android triple / API level
         (21+) to compile and link for. -->
    <LinkerArg Condition="$(RuntimeIdentifier.EndsWith('-arm64'))" Include="--target=aarch64-linux-android21"/>
    <LinkerArg Condition="$(RuntimeIdentifier.EndsWith('-x64'))"   Include="--target=x86_64-linux-android21"/>
    <LinkerArg Condition="$(RuntimeIdentifier.EndsWith('-arm'))"   Include="--target=armv7a-linux-androideabi21"/>
  </ItemGroup>

  <!-- Statically link OpenSSL when $(OpenSslDir) is provided (avoids runtime
       dependency on system libssl.so which may be the wrong version). -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux-bionic')) And '$(OpenSslDir)' != ''">
    <LinkerArg Include="-L$(OpenSslDir)/lib"/>
    <LinkerArg Include="-Wl,-Bstatic"/>
    <LinkerArg Include="-lssl"/>
    <LinkerArg Include="-lcrypto"/>
    <LinkerArg Include="-Wl,-Bdynamic"/>
  </ItemGroup>

  <!-- Windows-only: write .cmd shims so MSBuild can launch the NDK executables. -->
  <Target Name="PrepareNdkBatches"
          Condition="$(RuntimeIdentifier.StartsWith('linux-bionic')) And '$(OS)' == 'Windows_NT'"
          AfterTargets="Build" BeforeTargets="IlcCompile">
    <PropertyGroup>
      <NdkBin>$(ANDROID_NDK_ROOT)\toolchains\llvm\prebuilt\$(NdkHost)\bin\</NdkBin>
    </PropertyGroup>
    <WriteLinesToFile File="android-clang.cmd"          Lines="&quot;$(NdkBin)clang.exe&quot; %*" Overwrite="true"/>
    <WriteLinesToFile File="android-llvm-objcopy.cmd"   Lines="&quot;$(NdkBin)llvm-objcopy.exe&quot; %*" Overwrite="true"/>
  </Target>

  <Target Name="RemoveNdkBatches"
          Condition="$(RuntimeIdentifier.StartsWith('linux-bionic')) And '$(OS)' == 'Windows_NT'"
          AfterTargets="LinkNative">
    <Delete Files="android-clang.cmd;android-llvm-objcopy.cmd"/>
  </Target>

  <!-- NDK r26+ rejects the _init/_fini symbols that NativeAOT writes into the generated
       exports (version-script) file. Strip them before the native link step. -->
  <Target Name="StripInitFiniExports"
          Condition="$(RuntimeIdentifier.StartsWith('linux-bionic'))"
          AfterTargets="IlcCompile" BeforeTargets="LinkNative">
    <PropertyGroup Condition="Exists('$(ExportsFile)')">
      <_ExportsContent>$([System.IO.File]::ReadAllText('$(ExportsFile)'))</_ExportsContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(ExportsFile)"
                      Condition="'$(_ExportsContent)' != '' AND $(_ExportsContent.Contains('global: _init; _fini;'))"
                      Lines="$(_ExportsContent.Replace('global: _init; _fini;', 'global: '))"
                      Overwrite="true"/>
  </Target>
</Project>
